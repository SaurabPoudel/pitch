# ==============================================================================
# Public Environment Variables (Exposed to the browser: NEXT_PUBLIC_*)
# ==============================================================================

# Sanity Project ID (Found in your Sanity dashboard under Project Settings)
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id_here"

# Sanity Dataset (e.g., "production" or "development")
NEXT_PUBLIC_SANITY_DATASET="production"

# Sanity API Version (Format: YYYY-MM-DD, e.g., "2024-10-30")
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-30"


# ==============================================================================
# Server-Only Secrets (Never expose to the client or commit to version control)
# ==============================================================================

# Sanity Write Token (Token with write/editor permissions for updating view counts)
SANITY_WRITE_TOKEN="your_sanity_write_token_here"

# NextAuth Secret (Generate via: openssl rand -base64 33 or npx auth secret)
AUTH_SECRET="your_nextauth_secret_here"

# GitHub OAuth App Credentials (Created in GitHub Developer Settings -> OAuth Apps)
AUTH_GITHUB_ID="your_github_oauth_client_id"
AUTH_GITHUB_SECRET="your_github_oauth_client_secret"
